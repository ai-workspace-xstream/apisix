[Unit]
Description=APISIX PostgreSQL configuration {{ apisix_pg_mode }}
After=network-online.target
Wants=network-online.target
ConditionPathExists={{ apisix_pg_environment_file }}

[Service]
Type=simple
User={{ apisix_pg_user }}
Group={{ apisix_pg_group }}
EnvironmentFile={{ apisix_pg_environment_file }}
Environment=APISIX_HOME={{ apisix_pg_home }}
WorkingDirectory={{ apisix_pg_home }}
ExecStart={{ apisix_pg_root }}/venv/bin/python {{ apisix_pg_root }}/gateway_config.py {{ apisix_pg_mode }} --gateway {{ apisix_pg_gateway }} --bootstrap {{ apisix_pg_home }}/conf/config.yaml --validator {{ apisix_pg_root }}/validate-native.sh{% if apisix_pg_mode == 'sync' %} --api {{ apisix_pg_api }} --output {{ apisix_pg_home }}/conf/apisix.yaml --state {{ apisix_pg_state }} --probe {{ apisix_pg_probe }}{% endif %}

Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ apisix_pg_home }}/conf {{ apisix_pg_state | dirname }}

[Install]
WantedBy=multi-user.target
